{
  "name": "nlbb",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --max-workers 1",
    "backend:dev": "npm --prefix backend run dev",
    "backend:dev:local": "npm --prefix backend run dev:local",
    "start:safe": "expo start --clear --max-workers 1 --port 19000",
    "android": "expo run:android",
    "android:safe": "expo start --clear --max-workers 1 --port 19000 --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:clear": "expo start --clear --max-workers 1",
    "build:apk": "eas build -p android --profile preview",
    "build:aab": "eas build -p android --profile production",
    "start:win": "expo start --clear --offline --max-workers 1 --port 8082",
    "android:win": "expo start --clear --offline --max-workers 1 --port 8082 --android",
    "web:win": "expo start --clear --offline --max-workers 1 --port 8082 --web",
    "start:win:tunnel": "expo start --clear --offline --max-workers 1 --port 8082 --tunnel",
    "web:pwa:dev": "npm --prefix web run dev",
    "web:pwa:build": "npm --prefix web run build",
    "web:pwa:preview": "npm --prefix web run preview",
    "typecheck": "tsc --noEmit",
    "screenshots:avd": "powershell -ExecutionPolicy Bypass -File ./scripts/create-avds.ps1",
    "screenshots:phone": "powershell -ExecutionPolicy Bypass -File ./scripts/run-maestro-screenshots.ps1 -DeviceLabel phone",
    "screenshots:tablet": "powershell -ExecutionPolicy Bypass -File ./scripts/run-maestro-screenshots.ps1 -DeviceLabel tablet"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.17.5",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
